import json
import os
import random
import time

from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.constants import ChatType
from telegram.ext import (
    Application,
    CommandHandler,
    MessageHandler,
    CallbackQueryHandler,
    ContextTypes,
    filters,
)

# =========================
# تنظیمات
# =========================
TOKEN = "PUT_YOUR_BOT_TOKEN_HERE"
OWNER_ID = 7860500580
DATA_FILE = "power_bot_data.json"
MINING_COOLDOWN = 180  # 3 minutes
DIAMOND_TO_COIN = 10

MINE_WORDS = {
    "استخراج",
    "استخراج الماس",
    "استر",
    "استخر",
    "mine",
}

# =========================
# داده‌ها
# =========================
data = {
    "users": {},
    "mining": {},
}


# =========================
# ذخیره / بارگذاری
# =========================
def load_data():
    global data
    if os.path.exists(DATA_FILE):
        try:
            with open(DATA_FILE, "r", encoding="utf-8") as file:
                loaded = json.load(file)
                data["users"] = loaded.get("users", {})
                data["mining"] = loaded.get("mining", {})
        except Exception as error:
            print("خطا در بارگذاری اطلاعات:", error)


def save_data():
    try:
        with open(DATA_FILE, "w", encoding="utf-8") as file:
            json.dump(data, file, ensure_ascii=False, indent=2)
    except Exception as error:
        print("خطا در ذخیره اطلاعات:", error)


# =========================
# کاربران
# =========================
def ensure_user(user_id, name):
    user_id = str(user_id)
    if user_id not in data["users"]:
        data["users"][user_id] = {
            "name": name,
            "diamonds": 100,
            "coins": 0,
        }
        save_data()
    else:
        data["users"][user_id]["name"] = name
        save_data()


def get_user(user_id, name="کاربر"):
    user_id = str(user_id)
    ensure_user(user_id, name)
    return data["users"][user_id]


def get_diamonds(user_id, name="کاربر"):
    if int(user_id) == OWNER_ID:
        return float("inf")
    return get_user(user_id, name)["diamonds"]


def get_coins(user_id, name="کاربر"):
    if int(user_id) == OWNER_ID:
        return float("inf")
    return get_user(user_id, name)["coins"]


def add_diamonds(user_id, amount, name="کاربر"):
    user = get_user(user_id, name)
    user["diamonds"] += amount
    save_data()


def add_coins(user_id, amount, name="کاربر"):
    user = get_user(user_id, name)
    user["coins"] += amount
    save_data()


def remove_coins(user_id, amount, name="کاربر"):
    user = get_user(user_id, name)
    if user["coins"] >= amount:
        user["coins"] -= amount
        save_data()
        return True
    return False


# =========================
# ابزارها
# =========================
def mining_key(user_id, chat_id):
    return f"{user_id}:{chat_id}"


def get_remaining(user_id, chat_id):
    key = mining_key(user_id, chat_id)
    last_time = data["mining"].get(key, 0)
    elapsed = time.time() - last_time
    remaining = MINING_COOLDOWN - elapsed
    return max(0, int(remaining))


def format_remaining(seconds):
    minutes = seconds // 60
    sec = seconds % 60
    if minutes > 0:
        return f"{minutes} دقیقه و {sec} ثانیه"
    return f"{sec} ثانیه"


def is_private(update: Update):
    return update.effective_chat and update.effective_chat.type == ChatType.PRIVATE


def is_group(update: Update):
    return update.effective_chat and update.effective_chat.type in (
        ChatType.GROUP,
        ChatType.SUPERGROUP,
    )


